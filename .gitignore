# ---- SUPER SKY FURY .gitignore ----

# Python wheels and caches (local tool installs)
/*.whl
__pycache__/
*.pyc

# Build output (all regenerated by ./build.sh)
/build/
/assets/
/music/build/
/music/build_draft*/

# Root ROMs: dev builds and milestone copies. The release ROM lives in dist/
/*.sfc
*.srm
*.state

# Dev captures, progress snapshots and reference images
/shots/
/progress/
/ref/
*.mp4
*.gif
*.ppm
*.wav

# Emulator cores and compiled harness (third-party / platform binaries)
/tools/cores/
/tools/lrharness
*.so
*.o

# Superseded source variants and music drafts (history, not used by the build)
/src/combat_v1.s
/src/main_enemies_v1.s
/src/main_v4.s
/tools/gen_assets_*_v*.py
/tools/gen_assets_v*.py
/music/make_music_draft*.py
/music/make_music_enemies_v1.py
/music/main_draft2.s
/music/draft1.*
/music/draft2.*
/music/draft3.*
/music/draft4.*
/music/enemies_v1.spc
/music/*.sfc

# Editor / OS noise
.DS_Store
*.swp
*~
